# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contabilidad
DB_USER=contabilidad
DB_PASSWORD=cambie-esta-clave

# --- Administrador inicial ---
# Solo se usa cuando la base de datos no tiene usuarios. Mínimo 12 caracteres.
APP_ADMIN_USUARIO=admin
APP_ADMIN_NOMBRE=Administrador del sistema
APP_ADMIN_EMAIL=admin@empresa.local
APP_ADMIN_PASSWORD=

# --- Servidor ---
SERVER_PORT=8080
# Orígenes permitidos para CORS (solo si el frontend se sirve desde otro dominio).
APP_CORS_ORIGENES=http://localhost:5173
